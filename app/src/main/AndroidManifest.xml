<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoiceInteractionAppSample">

        <!-- issue #43: launched by Settings' gear icon as a plain explicit intent
             (android:settingsActivity in via's interaction_service.xml), from another
             package (com.android.settings) — must be exported, and must work standalone
             with no VoiceInteractionSession bound. -->
        <activity
            android:name=".ServerSettingsActivity"
            android:label="@string/server_settings_title"
            android:exported="true" />
    </application>

</manifest>