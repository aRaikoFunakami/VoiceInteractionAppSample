<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/server_settings_title"
        android:textSize="20sp"
        android:layout_marginBottom="16dp" />

    <RadioGroup
        android:id="@+id/mode_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/server_settings_section_server"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:textAllCaps="true" />

        <RadioButton
            android:id="@+id/mode_openai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/server_settings_mode_openai" />

        <RadioButton
            android:id="@+id/mode_local"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/server_settings_mode_local" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/server_settings_section_ondevice"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:textAllCaps="true" />

        <RadioButton
            android:id="@+id/mode_local_agent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/server_settings_mode_local_agent" />
    </RadioGroup>

    <EditText
        android:id="@+id/local_host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/server_settings_local_host_hint"
        android:inputType="textUri" />

    <Button
        android:id="@+id/save_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/server_settings_save" />

</LinearLayout>
